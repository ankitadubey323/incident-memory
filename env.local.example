# Local development settings (DynamoDB Local in Docker — no AWS account needed).
# Copy to `.env` and load with:   set -a; source .env; set +a
TABLE_NAME=incident_memory
AWS_REGION=eu-central-1
DDB_ENDPOINT=http://localhost:8002     # remove this line to talk to real AWS
AWS_ACCESS_KEY_ID=local                # DynamoDB Local accepts any value
AWS_SECRET_ACCESS_KEY=local
MCP_TRANSPORT=stdio                    # streamable-http on EC2
